#!/usr/bin/env bash
# proddb — open a read-only psql session against the aerolith production DB.
# Sets up an SSH tunnel on localhost:15438 if one isn't already running,
# then launches psql. Credentials are read from .env.proddb, which should hold
# a read-only role's login (see the CREATE ROLE notes in the PR / README).
#
# Read-only is enforced twice: the role itself defaults to read-only
# transactions, and this script sets it again for the session.

set -euo pipefail

ENV_FILE="$(cd "$(dirname "$0")/.." && pwd)/.env.proddb"
SOCK="/tmp/aerolith-db.sock"
LOCAL_PORT=15438
SSH_HOST="db.aerolith.org"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "error: env file not found: $ENV_FILE" >&2
  exit 1
fi

_env_val() {
  grep -E "^$1=" "$ENV_FILE" | head -1 | cut -d= -f2-
}

DB_USER=$(_env_val PROD_DB_USER)
DB_PASS=$(_env_val PROD_DB_PASSWORD)
DB_NAME=$(_env_val PROD_DB_NAME)

_tunnel_alive() {
  ssh -S "$SOCK" -O check "$SSH_HOST" &>/dev/null
}

_port_in_use() {
  ss -tlnp 2>/dev/null | grep -q ":${LOCAL_PORT} " || \
    lsof -i "TCP:${LOCAL_PORT}" -sTCP:LISTEN &>/dev/null
}

if _tunnel_alive && _port_in_use; then
  : # tunnel is up and port is bound, reuse it
elif _port_in_use; then
  # Leftover process bound to the port but control socket is gone — kill and reopen.
  echo "Port $LOCAL_PORT in use without a live control socket — cleaning up ..." >&2
  fuser -k "${LOCAL_PORT}/tcp" &>/dev/null || true
  rm -f "$SOCK"
  sleep 0.3
  echo "Opening SSH tunnel to $SSH_HOST:5432 → localhost:$LOCAL_PORT ..." >&2
  ssh -fNM -S "$SOCK" -L "${LOCAL_PORT}:localhost:5432" "$SSH_HOST"
  sleep 0.5
else
  echo "Opening SSH tunnel to $SSH_HOST:5432 → localhost:$LOCAL_PORT ..." >&2
  ssh -fNM -S "$SOCK" -L "${LOCAL_PORT}:localhost:5432" "$SSH_HOST"
  sleep 0.5
fi

PGOPTIONS="-c default_transaction_read_only=on -c statement_timeout=30s" \
  PGPASSWORD="$DB_PASS" \
  exec psql -h localhost -p "$LOCAL_PORT" -U "$DB_USER" -d "$DB_NAME" "$@"
